<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MK1300 Controller"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnScanConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scan &amp; Connect" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disconnected"
            android:textColor="#FF0000"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnToggleMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Switch to Per-Key Matrix"
            android:layout_marginBottom="16dp" />

        <!-- GLOBAL CONTROLS -->
        <LinearLayout
            android:id="@+id/layoutGlobal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Effect Mode"
                android:layout_gravity="start" />
            <Spinner
                android:id="@+id/spinnerEffect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Brightness (0–4)"
                android:layout_gravity="start" />
            <SeekBar
                android:id="@+id/seekBrightness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="4"
                android:progress="4"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Speed (0–4)"
                android:layout_gravity="start" />
            <SeekBar
                android:id="@+id/seekSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="4"
                android:progress="2"
                android:layout_marginBottom="16dp" />
        </LinearLayout>

        <!-- PER-KEY MATRIX CONTROLS -->
        <LinearLayout
            android:id="@+id/layoutPerKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap any key to apply the color. Scroll horizontally to see all keys."
                android:layout_marginBottom="8dp"/>

            <!-- The Keyboard Horizontal Scroll -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:scrollbars="horizontal"
                android:background="#222222"> <!-- Dark background makes keyboard pop -->
                
                <LinearLayout
                    android:id="@+id/keyRowContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp"/>
            </HorizontalScrollView>

            <Button
                android:id="@+id/btnApplyAll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Apply Color to ALL Keys"
                android:layout_marginBottom="16dp"/>
        </LinearLayout>

        <!-- COLOR PICKER SECTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hex Color Code"
            android:layout_gravity="start" />
        <EditText
            android:id="@+id/etHex"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:hint="#FFFFFF"
            android:maxLength="7"
            android:singleLine="true"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Red (0–255)"
            android:layout_gravity="start" />
        <SeekBar
            android:id="@+id/seekR"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="255"
            android:progress="0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Green (0–255)"
            android:layout_gravity="start" />
        <SeekBar
            android:id="@+id/seekG"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="255"
            android:progress="255" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Blue (0–255)"
            android:layout_gravity="start" />
        <SeekBar
            android:id="@+id/seekB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="255"
            android:progress="255"
            android:layout_marginBottom="12dp" />

        <View
            android:id="@+id/colorPreview"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#00FFFF"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnLuck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎲 Try Your Luck" />

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:layout_marginTop="16dp"
            android:text="Logs will appear here." />

    </LinearLayout>
</ScrollView>
